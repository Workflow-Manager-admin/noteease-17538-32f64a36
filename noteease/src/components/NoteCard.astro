---
const { note } = Astro.props;

// Format the date to be more readable
function formatDate(dateString) {
  const date = new Date(dateString);
  return new Intl.DateTimeFormat('en-US', { 
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  }).format(date);
}

// Get a preview of the content (limit to around 100 characters)
const contentPreview = note.content.length > 100 
  ? note.content.substring(0, 100) + '...' 
  : note.content;
---

<div class="card note-card" data-note-id={note.id}>
  <div class="note-header">
    <h3 class="note-title">{note.title}</h3>
    <div class="note-actions">
      <button class="note-action edit-note" aria-label="Edit note">
        <span class="material-icons">edit</span>
      </button>
      <button class="note-action delete-note" aria-label="Delete note">
        <span class="material-icons">delete</span>
      </button>
    </div>
  </div>
  
  <div class="note-content">{contentPreview}</div>
  
  <div class="note-footer">
    <span class="note-category">{note.category}</span>
    <span class="note-date">{formatDate(note.updatedAt)}</span>
  </div>
</div>

<style>
  .note-card {
    cursor: pointer;
    position: relative;
  }
  
  .note-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--spacing-sm);
  }
  
  .note-title {
    margin: 0;
    font-size: var(--font-size-md);
    word-break: break-word;
  }
  
  .note-content {
    color: #666;
    margin-bottom: var(--spacing-md);
    font-size: var(--font-size-sm);
    word-break: break-word;
  }
  
  .note-footer {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-xs);
    color: #888;
  }
  
  .note-category {
    background-color: rgba(25, 118, 210, 0.1);
    color: var(--primary-color);
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 500;
  }
  
  .note-actions {
    display: flex;
    gap: var(--spacing-xs);
  }
  
  .note-action {
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    border-radius: 50%;
    width: 28px;
    height: 28px;
  }
  
  .note-action:hover {
    background-color: rgba(0, 0, 0, 0.05);
    color: #333;
  }
  
  .note-action .material-icons {
    font-size: 16px;
  }
  
  .edit-note:hover {
    color: var(--primary-color);
  }
  
  .delete-note:hover {
    color: #f44336;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Attach event listeners to note cards
    document.querySelectorAll(".note-card").forEach(card => {
      const noteId = parseInt(card.dataset.noteId);
      
      // Handle click on the card (view note)
      card.addEventListener("click", (e) => {
        // Prevent triggering when clicking on action buttons
        if (!e.target.closest('.note-action')) {
          document.dispatchEvent(new CustomEvent("viewNote", { 
            detail: { noteId }
          }));
        }
      });
      
      // Handle edit button click
      card.querySelector(".edit-note").addEventListener("click", (e) => {
        e.stopPropagation(); // Prevent card click
        document.dispatchEvent(new CustomEvent("editNote", { 
          detail: { noteId }
        }));
      });
      
      // Handle delete button click
      card.querySelector(".delete-note").addEventListener("click", (e) => {
        e.stopPropagation(); // Prevent card click
        
        if (confirm("Are you sure you want to delete this note?")) {
          document.dispatchEvent(new CustomEvent("deleteNote", { 
            detail: { noteId }
          }));
        }
      });
    });
  });
</script>
