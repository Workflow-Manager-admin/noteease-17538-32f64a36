---
import notesStore from "../store/notesStore";
import NoteCard from "./NoteCard.astro";

// Get all notes from store
// We'll filter them client-side for reactivity
const allNotes = notesStore.getNotes();
---

<div class="note-list" id="noteList">
  {allNotes.length > 0 ? (
    allNotes.map((note) => (
      <NoteCard note={note} />
    ))
  ) : (
    <div class="empty-state">
      <span class="material-icons empty-icon">note_add</span>
      <p>No notes found</p>
      <button class="btn btn-primary create-note-btn" id="emptyStateCreateBtn">
        Create your first note
      </button>
    </div>
  )}
</div>

<style>
  .note-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--spacing-md);
    padding: var(--spacing-md) 0;
  }
  
  .empty-state {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xl);
    text-align: center;
    color: #666;
  }
  
  .empty-icon {
    font-size: 48px;
    color: #ccc;
    margin-bottom: var(--spacing-md);
  }
  
  .create-note-btn {
    margin-top: var(--spacing-md);
  }
  
  @media (max-width: 768px) {
    .note-list {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import notesStore from "../store/notesStore";

  document.addEventListener("DOMContentLoaded", () => {
    const noteListElement = document.getElementById("noteList");
    const emptyStateBtn = document.getElementById("emptyStateCreateBtn");
    
    // Function to render notes based on current filters
    function renderNotes() {
      const notes = notesStore.getNotes();
      
      // Clear current list
      noteListElement.innerHTML = "";
      
      if (notes.length > 0) {
        // Create and append note cards
        notes.forEach(note => {
          const noteCard = createNoteCard(note);
          noteListElement.appendChild(noteCard);
        });
      } else {
        // Show empty state
        noteListElement.innerHTML = `
          <div class="empty-state">
            <span class="material-icons empty-icon">note_add</span>
            <p>No notes found</p>
            <button class="btn btn-primary create-note-btn" id="emptyStateCreateBtn">
              Create your first note
            </button>
          </div>
        `;
        
        // Add event listener to new button
        document.getElementById("emptyStateCreateBtn").addEventListener("click", () => {
          document.dispatchEvent(new CustomEvent("newNote"));
        });
      }
    }
    
    // Helper function to create a note card element
    function createNoteCard(note) {
      // Format date helper
      function formatDate(dateString) {
        const date = new Date(dateString);
        return new Intl.DateTimeFormat('en-US', { 
          month: 'short',
          day: 'numeric',
          year: 'numeric'
        }).format(date);
      }
      
      // Get a preview of the content
      const contentPreview = note.content.length > 100 
        ? note.content.substring(0, 100) + '...' 
        : note.content;
      
      // Create card element
      const card = document.createElement("div");
      card.className = "card note-card";
      card.dataset.noteId = note.id;
      
      card.innerHTML = `
        <div class="note-header">
          <h3 class="note-title">${note.title}</h3>
          <div class="note-actions">
            <button class="note-action edit-note" aria-label="Edit note">
              <span class="material-icons">edit</span>
            </button>
            <button class="note-action delete-note" aria-label="Delete note">
              <span class="material-icons">delete</span>
            </button>
          </div>
        </div>
        
        <div class="note-content">${contentPreview}</div>
        
        <div class="note-footer">
          <span class="note-category">${note.category}</span>
          <span class="note-date">${formatDate(note.updatedAt)}</span>
        </div>
      `;
      
      // Add event listeners
      card.addEventListener("click", (e) => {
        // Prevent triggering when clicking on action buttons
        if (!e.target.closest('.note-action')) {
          document.dispatchEvent(new CustomEvent("viewNote", { 
            detail: { noteId: note.id }
          }));
        }
      });
      
      // Edit button
      card.querySelector(".edit-note").addEventListener("click", (e) => {
        e.stopPropagation(); // Prevent card click
        document.dispatchEvent(new CustomEvent("editNote", { 
          detail: { noteId: note.id }
        }));
      });
      
      // Delete button
      card.querySelector(".delete-note").addEventListener("click", (e) => {
        e.stopPropagation(); // Prevent card click
        
        if (confirm("Are you sure you want to delete this note?")) {
          notesStore.deleteNote(note.id);
          renderNotes();
        }
      });
      
      return card;
    }
    
    // Initial empty state button
    if (emptyStateBtn) {
      emptyStateBtn.addEventListener("click", () => {
        document.dispatchEvent(new CustomEvent("newNote"));
      });
    }
    
    // Listen for events that should trigger re-rendering
    document.addEventListener("notesChanged", renderNotes);
    document.addEventListener("categoryChanged", renderNotes);
    document.addEventListener("searchQueryChanged", renderNotes);
  });
</script>
