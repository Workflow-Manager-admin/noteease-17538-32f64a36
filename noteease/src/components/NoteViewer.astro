---
// Note viewer component for displaying a note in a modal
---

<div class="modal-overlay" id="noteViewerModal">
  <div class="modal">
    <div class="modal-header">
      <h2 id="viewerTitle"></h2>
      <button class="modal-close" id="closeViewer">
        <span class="material-icons">close</span>
      </button>
    </div>
    
    <div class="modal-body">
      <div class="note-details">
        <div class="note-metadata">
          <span class="note-category" id="viewerCategory"></span>
          <span class="note-date" id="viewerDate"></span>
        </div>
        
        <div class="note-full-content" id="viewerContent"></div>
      </div>
    </div>
    
    <div class="modal-footer">
      <button class="btn" id="closeViewerBtn">Close</button>
      <button class="btn btn-primary" id="editFromViewerBtn">Edit</button>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    display: none;
  }
  
  .modal-overlay.visible {
    display: flex;
  }
  
  .modal {
    animation: slideUp 0.3s ease-out;
  }
  
  @keyframes slideUp {
    from {
      transform: translateY(20px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  
  .note-metadata {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--spacing-md);
    font-size: var(--font-size-sm);
    color: #666;
  }
  
  .note-category {
    background-color: rgba(25, 118, 210, 0.1);
    color: var(--primary-color);
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 500;
  }
  
  .note-full-content {
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.6;
  }
</style>

<script>
  import notesStore from "../store/notesStore";
  
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("noteViewerModal");
    const titleElement = document.getElementById("viewerTitle");
    const categoryElement = document.getElementById("viewerCategory");
    const dateElement = document.getElementById("viewerDate");
    const contentElement = document.getElementById("viewerContent");
    const closeButton = document.getElementById("closeViewer");
    const closeViewerBtn = document.getElementById("closeViewerBtn");
    const editButton = document.getElementById("editFromViewerBtn");
    
    // Format date helper
    function formatDate(dateString) {
      const date = new Date(dateString);
      return new Intl.DateTimeFormat('en-US', { 
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      }).format(date);
    }
    
    // Current note ID being viewed
    let currentNoteId = null;
    
    // Function to show modal
    function showModal(noteId) {
      const note = notesStore.getNoteById(parseInt(noteId));
      
      if (note) {
        currentNoteId = note.id;
        
        // Set note details
        titleElement.textContent = note.title;
        categoryElement.textContent = note.category;
        dateElement.textContent = `Updated: ${formatDate(note.updatedAt)}`;
        contentElement.textContent = note.content;
        
        // Show modal
        modal.classList.add("visible");
      }
    }
    
    // Function to hide modal
    function hideModal() {
      modal.classList.remove("visible");
      currentNoteId = null;
    }
    
    // Close modal events
    closeButton.addEventListener("click", hideModal);
    closeViewerBtn.addEventListener("click", hideModal);
    
    // Click outside modal to close
    modal.addEventListener("click", (e) => {
      if (e.target === modal) {
        hideModal();
      }
    });
    
    // Edit button event
    editButton.addEventListener("click", () => {
      if (currentNoteId) {
        // Hide viewer modal
        hideModal();
        
        // Dispatch edit note event
        document.dispatchEvent(new CustomEvent("editNote", { 
          detail: { noteId: currentNoteId }
        }));
      }
    });
    
    // Listen for view note event
    document.addEventListener("viewNote", (e) => {
      const { noteId } = e.detail;
      showModal(noteId);
    });
  });
</script>
